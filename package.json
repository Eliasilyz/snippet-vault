{
  "name": "snippet-vault",
  "version": "0.1.0",
  "description": "A local-first CLI tool for saving, organizing, and searching code snippets from the terminal.",
  "main": "src/index.js",
  "bin": {
    "snippet": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "jest --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix"
  },
  "keywords": [
    "cli",
    "snippets",
    "developer-tools",
    "local-first",
    "terminal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliasilyz/snippet-vault.git"
  },
  "bugs": {
    "url": "https://github.com/eliasilyz/snippet-vault/issues"
  },
  "homepage": "https://github.com/eliasilyz/snippet-vault#readme",
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.js"]
  }
}
